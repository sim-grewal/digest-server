PORT=3000
API_KEY=

# "production" enforces HTTPS via X-Forwarded-Proto (e.g. behind the
# Cloudflare Tunnel). Leave unset for local development over plain HTTP.
NODE_ENV=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

RECIPIENT_EMAIL=

# Instapaper (optional) — saves article URLs from each digest
INSTAPAPER_USERNAME=
INSTAPAPER_PASSWORD=

# TTS audio attachment for [AUDIO] drafts.
# Set OPENAI_TTS_API_KEY to use OpenAI (tts-1-hd, best quality).
# Leave blank to use local Kokoro container (free, good quality).
OPENAI_TTS_API_KEY=

# Home Server lesson progress (/lesson/progress, /lesson/sent, /lesson/done).
# Random secret used as ?key= in links. Generate with: openssl rand -hex 24
LESSON_KEY=
